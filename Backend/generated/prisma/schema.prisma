// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChallengeStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships       GroupMember[]
  submissions       Submission[]
  stats             UserGroupStats[]
  createdChallenges DailyChallenge[] @relation("ChallengeCreator")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  members     GroupMember[]
  challenges  DailyChallenge[]
  stats       UserGroupStats[]
  submissions Submission[]
}

model GroupMember {
  id String @id @default(uuid())

  userId  String
  groupId String

  role Role @default(MEMBER)

  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model DailyChallenge {
  id String @id @default(uuid())

  groupId   String
  createdBy String?

  date        DateTime
  problemLink String?

  status ChallengeStatus @default(WAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id])

  creator User? @relation("ChallengeCreator", fields: [createdBy], references: [id])

  submissions Submission[]

  @@unique([groupId, date])
}

model Submission {
  id String @id @default(uuid())

  userId      String
  groupId     String
  challengeId String

  solved Boolean @default(true)

  solvedAt DateTime @default(now())

  timeTaken Int?

  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id])
  group     Group          @relation(fields: [groupId], references: [id])
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

model UserGroupStats {
  id String @id @default(uuid())

  userId  String
  groupId String

  currentStreak Int @default(0)

  longestStreak Int @default(0)

  totalSolved Int @default(0)

  last7DaysSolved Int @default(0)

  last30DaysSolved Int @default(0)

  freezeCount Int @default(2)

  lastSolvedDate DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}
